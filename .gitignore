# Gradle build output and caches (regenerated by ./gradlew)
build/
.gradle/

# Kotlin compiler/IDE cache (regenerated)
.kotlin/

# Android Studio / IntelliJ project files (regenerated by opening the project)
.idea/
*.iml

# Machine-local SDK path — every clone must set this itself
local.properties

# Native build caches (only appear if a native/NDK module is added later)
.externalNativeBuild/
.cxx/

# Built app binaries — build them from source instead of tracking them
*.apk
*.aab
*.ap_
*.dex

# Signing keys — never commit these
*.jks
*.keystore

# DJI App Key. This repository is PUBLIC: the real key must never be committed.
# Ship a placeholder and have each builder request their own key for their own
# package name. Uncomment when the MSDK is wired in and the key lives here.
# gradle.properties

# Misc
*.hprof
*.log
.DS_Store
